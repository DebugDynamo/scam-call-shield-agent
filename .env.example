# Scam Call Shield Environment Configuration
# Copy to .env and fill in GEMINI_API_KEY for real Gemini multimodal inference.
# Set LLM_PROVIDER=mock for offline deterministic demo mode.

PORT=8080
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=25.0
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8003,http://localhost:5173,http://localhost:5170
