# Copy to .env (git-ignored). Secrets live only here / in the process env. Never put them in web/.
# --- server ---
PORT=8003
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5170,http://localhost:5173,http://127.0.0.1:5170,http://127.0.0.1:5173
# When set, X-Api-Key is required on POST /api/v1/telephony/outbound and POST /api/v1/admin/cleanup
INTERNAL_API_KEY=
LOG_LEVEL=INFO

# --- data ---
DATA_MODE=mock                 # mock = in-memory (lost on restart) | postgres
# DATABASE_URL takes precedence over DB_* when set
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=garbathon_voice
DB_SSL=false
PERSIST_TRANSCRIPTS=true       # false: message text is not stored, tool traces are redacted; never any raw audio
SESSION_TTL_SECONDS=1800       # idle sessions are ended by a background sweeper
CLEANUP_INTERVAL_SECONDS=60

# --- providers (no silent fallback; mock only when selected) ---
LLM_PROVIDER=gemini            # gemini | mock
STT_PROVIDER=sarvam            # sarvam | google | mock
TTS_PROVIDER=google            # google (Gemini TTS) | elevenlabs | sarvam | mock
GEMINI_API_KEY=                # GOOGLE_API_KEY is accepted as an alias
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_VOICE=Kore
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
SARVAM_API_KEY=
SARVAM_TTS_VOICE=shubh
# Google Cloud STT (not the Gemini key): path to a service-account JSON, or the JSON inline
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CREDENTIALS_JSON=
VOICE_LANGUAGE=en-IN
LLM_TIMEOUT_SECONDS=30
# SYSTEM_PROMPT=...            # overrides the neutral default prompt

# --- tools ---
TOOL_PERMISSIONS=tasks:read,tasks:write,calc:use,search:read,approvals:request,agent:invoke
APPROVAL_TTL_SECONDS=300
SEARCH_API_URL=                # optional JSON search backend (GET ?q=); unset => web_search reports "unavailable"
SEARCH_API_KEY=
AGENT_API_URL=                 # optional repo-agent, e.g. http://localhost:3001 ; its /api/v1/tools are proxied as agent_*
AGENT_API_KEY=

# --- browser voice ---
ICE_SERVERS=stun:stun.l.google.com:19302

# --- phone (Plivo). Calls only ever start from POST /api/v1/telephony/outbound with confirm=true ---
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
PUBLIC_BASE_URL=               # public https URL of THIS server (tunnel in dev); used for webhooks + wss stream
PLIVO_VERIFY_SIGNATURE=true
PLIVO_ALLOW_INBOUND=false      # true: answer inbound calls to your Plivo number with a bot session
